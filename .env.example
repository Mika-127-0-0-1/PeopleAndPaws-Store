# Clerk authentication (Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin API for one store. Replace STORE_ID after creating/finding the store.
# Local example: http://localhost:3000/api/stores/STORE_ID
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://your-domain.co.za
UNIQUE_STORE_ID=

# Must exactly match the admin application's ENCRYPTION_SECRET.
ENCRYPTION_SECRET=
